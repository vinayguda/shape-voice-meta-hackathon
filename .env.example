# Copy to .env if you want Live mode. Demo mode runs the full interview with this file empty.
# Never commit a real key. Meta keys look like LLM_...

# Meta Model API key from https://dev.meta.ai (dashboard → API keys).
# Shape reads META_API_KEY, then MODEL_API_KEY (the name used in Meta's docs).
META_API_KEY=

# OpenAI-compatible base URL. Do not add a trailing path beyond /v1.
META_BASE_URL=https://api.meta.ai/v1

# Interview, follow-ups, slot extraction, and PRD drafting.
# Muse Spark is a reasoning model: keep this cap generous. A cap of 20 returns
# content=null and finish_reason=length because reasoning tokens spend the budget.
META_MODEL=muse-spark-1.3
# META_MAX_TOKENS=1500

# Optional. Sent as reasoning_effort. If the API returns HTTP 400 for it, Shape
# retries once without it and keeps that choice for the rest of the process.
# Set to off to never send it.
# META_REASONING_EFFORT=low

# Microphone. With META_API_KEY set, Mic records a clip and Shape posts
# 16 kHz mono WAV to POST /v1/asr/transcribe (muse-voice-transcribe-1.0).
# The request JSON is {"model":"muse-voice-transcribe-1.0","audioEncoding":"WAV","sampleRateHertz":16000}.
# audioEncoding must be the uppercase string WAV.
# Set META_STT=browser to use the Web Speech API instead. That is also what
# the mic does when no API key is set. There is no Meta text-to-speech model;
# the browser speechSynthesis speaks the reply.
# META_STT=browser
# META_STT_MODEL=muse-voice-transcribe-1.0

# Set to 1 to force the canned interview even when a key is present.
# DEMO=1

# PORT=3000

# LiveKit voice agent. Leave all three empty to keep push-to-talk.
# Local dev server (livekit-server --dev). These values are the server's defaults.
# Install espeak-ng so Shape can speak into the room. Dev keys cannot call LiveKit Inference.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LiveKit Cloud. Speech out is LiveKit Inference (cartesia/sonic-3).
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Optional. 0 mints room tokens and does not start the agent worker.
# LIVEKIT_AGENT=0
# LIVEKIT_TTS=espeak
# LIVEKIT_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# LIVEKIT_STT_MODEL=deepgram/nova-3
